PORT=3000
# Optional but recommended for automatic schema setup with `npm run db:init`.
JWT_SECRET=
TOKEN_TTL_SECONDS=3600

USE_DATABASE=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

#input your OpenAI/Gemini API key and model name to enable AI features.
AI_API_KEY=your_api_key
AI_CHAT_MODEL=your_model_name


# Optional: creates an administrator on startup when no account uses this email.
ADMIN_NAME=QueueSmart Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Demonstration user shown on the frontend login page.
DEMO_USER_NAME=Demo User
DEMO_USER_EMAIL=user1@example.com
DEMO_USER_PASSWORD=password123